# Frontend public API URL (copy to frontend/.env.local when running Next.js directly).
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000

# Local Compose database password. Keep this equal to the database URL password
# when configuring the backend outside Compose. Replace the demo value before deployment.
POSTGRES_PASSWORD=transformhub

# Backend AI settings live in backend/.env. Copy backend/.env.example to backend/.env
# for Docker Compose and configure provider credentials there.
