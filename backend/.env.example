# Development defaults for Docker Compose. Rotate secrets and credentials before deployment.
APP_NAME=TransformHub AI
APP_ENV=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://transformhub:BALAJI24@postgres:5432/transformhub
JWT_SECRET_KEY=dev-only-change-this-to-a-random-64-character-secret-before-deployment
SESSION_SECRET_KEY=dev-only-change-this-session-secret-before-deployment
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=transformhub
MINIO_SECURE=false
REDIS_URL=redis://redis:6379/0

# Use demo for offline smoke tests, gemini for Google's hosted multilingual model, ollama for local, or litellm for OpenAI-compatible providers.
LLM_PROVIDER=demo
GENERATION_PROVIDER=
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LITELLM_API_BASE=http://host.docker.internal:8001/v1
LITELLM_API_KEY=local-token
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=180
EMBEDDING_PROVIDER=demo
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=768
RAG_TOP_K=5

FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
